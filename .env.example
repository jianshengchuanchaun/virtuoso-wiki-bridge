# Virtuoso Wiki Bridge configuration

# Run:
#   virtuoso-wiki-bridge init-vault ./vault
# to create concepts, entities, journal, Obsidian, projects, references, skills,
# sources, synthesis, _raw, _staging, _archives, and .obsidian automatically.
VWB_VAULT_PATH=./vault
VWB_SOURCES_DIR=./vault/sources

# Compatibility variables for agents/tools that already understand
# Ar9av/obsidian-wiki style configuration.
OBSIDIAN_VAULT_PATH=./vault
OBSIDIAN_SOURCES_DIR=./vault/sources

VWB_REMOTE_WORKDIR=~/virtuoso-work/virtuoso-wiki-bridge

# Bridge command. Defaults to the upstream virtuoso-bridge CLI on PATH.
VWB_VIRTUOSO_BRIDGE_CMD=virtuoso-bridge

# Optional SSH/Spectre fallback for direct netlist runs.
VWB_REMOTE_HOST=
VWB_REMOTE_USER=
VWB_REMOTE_PORT=22
VWB_SSH_KEY=
VWB_CADENCE_SETUP=
VWB_REMOTE_SHELL=bash
